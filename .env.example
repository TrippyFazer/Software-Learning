# =============================================================================
# Infrastructure Learning Lab — example environment
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored and MUST NEVER
# be committed. Every value here is a placeholder, not a real secret.
#
#   cp .env.example .env
#   # then edit .env
#
# Generate strong random values with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Deployment identity -----------------------------------------------------
# "development" relaxes cookie flags so http://localhost works.
# "production" forces Secure cookies and refuses to boot with weak defaults.
APP_ENV=development

# Public hostname the app is served from. Used for CORS and for the
# "About This Server" educational page. No secrets here — it is public anyway.
PUBLIC_HOSTNAME=learn.example.com

# --- Database ----------------------------------------------------------------
# PostgreSQL is reachable ONLY on the private Docker network. It is never
# published to the host or the internet. See docs/SECURITY.md.
POSTGRES_USER=learninglab
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=learninglab
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Sessions ----------------------------------------------------------------
# Secret used to sign/derive session material. Rotating it logs everyone out.
SESSION_SECRET=change-me-generate-with-secrets-token-urlsafe-48

# How long a login lasts before it must be re-established, in hours.
SESSION_TTL_HOURS=336

# Cookie name. No reason to change it, but it is not a secret.
SESSION_COOKIE_NAME=ill_session

# --- Login protection --------------------------------------------------------
# Failed logins per window before the account is temporarily locked.
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- Content -----------------------------------------------------------------
# Path to the version-controlled curriculum. Inside Docker this is a read-only
# mount; the application never writes to it.
CONTENT_ROOT=./content

# Reload curriculum from disk on every request. Handy while authoring lessons,
# wasteful in production.
CONTENT_HOT_RELOAD=true

# --- Bootstrap ---------------------------------------------------------------
# The single learner account, created by `scripts/create_user.py`.
# These are read only by that script — the API never reads them.
BOOTSTRAP_USER_EMAIL=learner@example.com
BOOTSTRAP_USER_PASSWORD=change-me-before-first-run
BOOTSTRAP_USER_NAME=Learner
